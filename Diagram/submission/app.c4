model {
  extend submission.submission_app {
      sub_ui = component 'Submission UI' 'User facing application for job submission and result viewing' { icon https://docs.federated-analytics.ac.uk/_next/static/media/fedres_primary.4b79cf09.png }
      sub_api = component 'Submission API' 'Backend for submission processes, handles user side data management and requests job dispatch' { icon https://docs.federated-analytics.ac.uk/_next/static/media/fedres_primary.4b79cf09.png }

      researcher -> sub_ui {title 'Views in browser'}
      sub_ui -> sub_api {title 'HTTP Requests'}
   }
}

views {
  view of submission.submission_app {
    title 'Submission App'
    include *
  }
}
