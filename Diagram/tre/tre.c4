model {
  extend tre {
    tre_ui = component 'TRE Agent UI'
    tre_api = component 'TRE API'

    camunda = component 'Camunda' 'Credential Handler'

    submission.rabbitmq -> tre_ui 'Picks up job'
    tre_ui -> camunda 'Configures job'

    camunda -> execution 'Forwards configured job'

    minio = component 'Minio' 'S3 Object Store'
    execution -> minio 'Stores job result'
    minio -> data_owner 'Notifies'
    minio -> submission.minio 'Transfers'
  }
}

views {
  view of tre {
    title 'TRE Service'
    include *
  }
}