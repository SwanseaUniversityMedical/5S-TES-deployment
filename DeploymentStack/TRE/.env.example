DEPLOYMENT_VERSION=2.1.0


# Application Name
AppName=Five Safes TES

# Internal Postgres Superuser creds
PGLOGIN=admin
PGPASSWORD=admin

# LDAP Credentials (to be changed in production)
LDAPAdminPassword=admin
LDAPConfigPassword=config

# Camunda Credentials (to be changed in production)
CamundaUsername=demo
CamundaPassword=demo

# Vault Credentials (to be filled in production - please follow the guide in the documentation to generate the token)
VaultRootToken=
# Vault Startup Command
VaultStartupCommand="vault server -config=/vault/config/config.json"

# Keycloak Credentials (to be changed in production)
KeycloakBootstrapAdminPassword=admin
# Keycloak Startup Command (if internal Keycloak is used and it has HTTPS enabled, use "start" instead of "start-dev")
KeycloakStartupCommand=start-dev

# RabbitMQ Credentials
RabbitMQDefaultPassword=rabbitmq

# Serilog Minimum Level
SerilogLevel=Warning

# Encryption settings (Base-64 String, generate by running: openssl rand -base64 32)
EncryptionSettingsKey=

# TRE Data DB Credentials
# Used for the TRE Agent to create temporary credentials against any Postgres database:
TRE_DATA_SERVER=postgres
TRE_DATA_PORT=5432
TRE_DATA_DATABASE=tredata
TRE_DATA_USER=admin
TRE_DATA_PASSWORD=admin

# Name of the deployed TRE
TreName=DEMO

# Local Keycloak Full URL (if using a local/internal Keycloak instance)
KeycloakFullURL=http://keycloak.localtest.me:8085

# TRE KEYCLOAK URL (KEEP THE SAME - if using a LOCAL Keycloak instance; CHANGE - if using a REMOTE Keycloak instance)
TRE_KEYCLOAK_URL=http://keycloak.localtest.me:8085

# SUBMISSION KEYCLOAK URL (KEEP THE SAME - in DEMO; CHANGE - in PRODUCTION)
SUBMISSION_KEYCLOAK_URL=http://keycloak.localtest.me:8085

# SUBMISSION API URL
SubmissionAPIAddressURL=http://localhost:5034

# Where TESK or Funnel API is hosted:
TesAPIUrl=http://localhost:8000/v1/tasks

## TRE S3 Settings
# TRE S3 Console URL
TRES3ConsoleUrl=http://localhost:9003
# TRE S3 OpenID Secret
TRES3OpenidSecret=71ee3de3-0e0c-49c8-a0b2-c0e490c90591
# TRE S3 Root User and Password
TRES3RootUser=s3-tre
TRES3RootPass=s3-tre-pass

## Submission S3 Settings
# Submission S3 API URL
SubmissionS3ApiUrl=http://rustfs_submission:9000
# Submission S3 Console URL
SubmissionS3ConsoleUrl=http://localhost:9001
# Submission S3 Root User and Password
SubmissionS3RootUser=s3-submission
SubmissionS3RootPass=s3-submission-pass

# Public URL of the TRE API
TreApiPublicUrl=http://localhost:8072

# Sync Settings:
# Sync Projects & Users between TRE & Submission Layer - default every 10 minutes
syncSchedule=10
# Scan Submission Layer for available submissions - default every 1 minute
scanSchedule=1

# Egress Keycloak Settings:
EgressKeyCloakClientUIRedirectURL=http://localhost:8100
EgressKeyCloakSecret=81c1f071-8c45-49ef-a966-84ca8f420b7e

# Submission Keycloak Settings - used to authorise TRE API against Submission API:
SubmissionAPIKeyCloakClientUIRedirectURL=http://localhost:8989
SubmissionAPIKeyCloakSecret=2e60b956-16bc-4dea-8b49-118a8baac5e5

# TRE UI Keycloak Settings:
TreKeyCloakClientUIRedirectURL=http://localhost:8989
TreKeyCloakSecret=2de114bc-3599-45f1-9b61-5090c6859dfe

# TRE API Keycloak Settings:
TreAPIKeyCloakClientUIRedirectURL=http://localhost:8989
TreAPIKeyCloakSecret=e9021a57-3f4f-4254-ba27-2cdbb99a2cb5

# New TRE UI env vars
# BETTER_AUTH_SECRET (Base-64 String, generate by running: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# URL of the Better Auth server. This is the URL of the NextJS app.
BETTER_AUTH_URL=http://localhost:3000

# Path to the config folder of TRE
CONFIG_PATH=../../../DeploymentStack/TRE/config

# Note: Env vars below are unlikely to be changed 
# Always keep this as false in real deployments:
SeedDemoData=false
# Demo Mode Password (unused, but here to prevent warnings)
DemoModePassword=password
# Always keep this as true in real deployments
UseTESK=true
# Allows Keycloak to not require https:
KeyCloakDemoMode=true
# Output bucket prefix for the TES executing agent to write results to
TesOutputBucketPrefix=s3://
# Proxy Settings (to be reviewed and removed):
useproxy=false
proxyurl=http://192.168.10.15:8080
#If having issues with keycloak set this to false.
sslcookies=false
#If http only site set this to false
httpsRedirect=false
# Hangfire settings
EnableExternalHangfire=true
HangfireUser=admin
HangfirePassword=password