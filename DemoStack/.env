DEPLOYMENT_VERSION=1.7.11

# Application Name
AppName=Five Safes TES

# -----  Env vars to be changed to escape simulation in DemoStack  ------

DemoMode=true
UseTESK=false

# ----- Postgres env var ------

PGLOGIN=admin
PGPASSWORD=admin

# ----- Serilog Minimum Level ------

SerilogLevel=Information

# ------ TRE DB Credentials ------

TRE_DATA_SERVER=postgres
TRE_DATA_PORT=5432
TRE_DATA_DATABASE=tredata
TRE_DATA_USER=admin
TRE_DATA_PASSWORD=admin

TreApiPublicUrl=http://localhost:8072
# Keycloak Host name
KeycloakHostName=localhost
# TRE KeyCloak URL
TRE_KEYCLOAK_URL=http://keycloak:8080
# Submission KeyCloak URL
SUBMISSION_KEYCLOAK_URL=http://keycloak:8080
# Minio TRE UI URL
MINIO_TRE_UI_URL=http://localhost:9003
# Submision API URL
SubmissionAPIAddressURL=http://submissionAPI:8080
# Encryption settings (Base-64 String) - Defaulted for development/demo purposes only - NEVER USE IN PRODUCTION
EncryptionSettingsKey=9pDUei4zHnuXrC0Hb0KSG0g1U4GsV6ajZf+/kYKtrI8=
# New TRE UI env vars
# Secret for Better Auth - Defaulted for development/demo purposes only - NEVER USE IN PRODUCTION
BETTER_AUTH_SECRET=r6oTUwEUlvoa4Fdh3XIBviHRVpCudrt3
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8085

KeyCloakDemoMode=true

http_proxy=http://192.168.10.15:8080
https_proxy=http://192.168.10.15:8080

useproxy=false
proxyurl=http://192.168.10.15:8080

sslcookies=false #If having issues with keycloak set this to false.
httpsRedirect=false #If http only site set this to false

# ----- Minio env var ------

MinioOpenidSecret=8a11bbcd-693a-4549-bda4-3e978fcf4de1
MinioTreOpenidSecret=71ee3de3-0e0c-49c8-a0b2-c0e490c90591

MinioRootUser=minio
MinioRootPass=minio123

TesAPIUrl=http://host.docker.internal:8000/v1/tasks # Where TESK or Funnel API is hosted:
# FunnelMinioUser=miniofunnel
# FunnelMinioPass=miniofunnel
TesOutputBucketPrefix=s3:// # Output bucket prefix for the TES executing agent to write results to

syncSchedule=2
scanSchedule=1
TreName=DEMO

EnableExternalHangfire=true
HangfireUser=admin
HangfirePassword=password

TreMinioAdminUser=minio
TreMinioAdminPassword=minio123

submissionMinioUrl=http://minioSubmission:9000
submissionMinioAdminConsole=http://localhost:9001

# ----- Egress Keycloak env var ------

EgressKeyCloakClientUIRedirectURL=https//localhost:8100/
EgressKeyCloakSecret=81c1f071-8c45-49ef-a966-84ca8f420b7e

# ----- Submission API Keycloak settings ------

SubmissionAPIKeyCloakClientUIRedirectURL=http://localhost:8989/
SubmissionAPIKeyCloakSecret=2e60b956-16bc-4dea-8b49-118a8baac5e5


# ----- Submission UI Keycloak settings ------

SubmissionKeyCloakClientUIRedirectURL=http://localhost:8888/
SubmissionUIClientSecret=1218304e-bf92-4706-83f6-912e0b04ecb9

# ----- TRE Keycloak settings ------

TreKeyCloakClientUIRedirectURL=http://localhost:8989/
TreKeyCloakTokenExpiredAddressUI=http://localhost:8989/Account/LoginAfterTokenExpired
TreKeyCloakSecret=2de114bc-3599-45f1-9b61-5090c6859dfe

# ----- TRE API Keycloak settings ------

TreAPIKeyCloakClientUIRedirectURL=http://localhost:8989/
TreAPIKeyCloakSecret=e9021a57-3f4f-4254-ba27-2cdbb99a2cb5

URLSettingsFrontEndQueryImageSQL=harbor.federated-analytics.ac.uk/5s-tes-analysis-tools/5s-tes-analysis-tools-tre-sqlpg:1.0.0

# ----- Submission Server Settings -----

SuppressAntiforgery=false
SubmissionSignedOutRedirectUri=/
SubmissionTokenRefreshSeconds=3600
SubmissionKeyCloakServer=keycloak:8080
SubmissionServerProtocol=http
SubmissionAutoTrustKeycloakCert=false
SubmissionValidIssuer=
SubmissionValidAudience=

# ------ Config path for infrastructure services ------
# ------ (Keycloak, Ldap, Ldap Init, Postgres, Realm Configuration) ------

CONFIG_PATH=../../../DemoStack/config